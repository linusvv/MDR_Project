<launch>
    <!-- ============================================================
         A* 전용 통합 launch. 기존 run_all.launch(teb)는 그대로 두고
         이 파일로 실행하면 local planner가 A* 하나만 뜬다.
         (run.launch / run_teb_planner.launch 는 include 하지 않으므로
          teb costmap 은 생성되지 않음 => costmap 1개만 동작)
         ============================================================ -->
    <arg name="use_rviz" default="false"/>
    <arg name="sim" default="false"/>

    <!-- 0. Tag Pose Injector logic has been moved into map_odom_publisher.py for smooth TF alignment -->

    <!-- ==================== SIMULATION SPECIFIC SETUP ==================== -->
    <group if="$(arg sim)">
        <!-- 1. Start Gazebo simulation with mecanum robot -->
        <include file="$(find nexus_4wd_mecanum_gazebo)/launch/nexus_4wd_mecanum_world.launch" />

        <!-- 2. Start AprilTag Localization for global pose correction -->
        <include file="$(find apriltag_localization)/launch/apriltag_localization.launch">
            <arg name="tag_file_name" value="2025/re540_simulation" />
            <arg name="camera_name" value="/camera/color" />
            <arg name="image_topic" value="image_raw" />
            <arg name="world_frame_name" value="map" />
            <arg name="camera_frame_name" value="camera_link" />
            <arg name="image_frame_name" value="camera_color_optical_frame" />
            <arg name="with_visualization" value="false" />
            <arg name="with_realsense_tf" value="false" />
            <arg name="broadcast_world2cam_tf" value="false" />
        </include>

        <!-- 3. Start RTAB-Map SLAM (Configured to use stable Wheel Odometry) -->
        <include file="$(find rtabmap_launch)/launch/rtabmap.launch">
            <arg name="rtabmap_args" value="--delete_db_on_start --Vis/MaxFeatures 2000 --Kp/MaxFeatures 2000 --Rtabmap/LoopThr 0.1 --Rtabmap/DetectionRate 1.0 --Mem/ImagePreDecimation 1 --Grid/MaxObstacleHeight 0.15 --Grid/RayTracing true --RGBD/ProximityBySpace true --RGBD/OptimizeFromGraphEnd false --Vis/MinInliers 10"/>
            <arg name="rgb_topic" value="/camera/color/image_raw_throttle"/>
            <arg name="depth_topic" value="/camera/aligned_depth_to_color/image_raw_throttle"/>
            <arg name="camera_info_topic" value="/camera/color/camera_info"/>
            <arg name="depth_camera_info_topic" value="/camera/color/camera_info"/>
            <arg name="frame_id" value="base_footprint"/>
            <arg name="odom_topic" value="/odom"/>
            <arg name="visual_odometry" value="true"/>
            <arg name="icp_odometry" value="false"/>
            <arg name="publish_tf_odom" value="true"/>
            <arg name="vo_frame_id" value="odom"/>
            <arg name="subscribe_scan" value="false"/>
            <arg name="approx_sync" value="true"/>
            <arg name="rviz" value="false"/>
            <arg name="rtabmap_viz" value="false"/>
            <arg name="odom_args" value="--Odom/ResetCountdown 2 --Vis/MaxFeatures 600 --Vis/MinInliers 10 --OdomF2M/MaxSize 1000 --Odom/KeyFrameThr 0.6"/>
            <arg name="map_frame_id" value="rtabmap_map"/>
        </include>
    </group>

    <!-- ==================== REAL ROBOT SPECIFIC SETUP ==================== -->
    <group unless="$(arg sim)">
        <!-- 1. Check if 3D camera is running, start it if not -->
        <node name="camera_checker" pkg="hw4_exploration" type="camera_checker.py" output="screen" />

        <!-- 1.5 Convert depth image to point cloud for local costmap -->
        <node pkg="nodelet" type="nodelet" name="depth_image_proc_manager" args="manager" output="screen" />
        <node pkg="nodelet" type="nodelet" name="depth_to_pointcloud" args="load depth_image_proc/point_cloud_xyz depth_image_proc_manager" output="screen">
            <remap from="camera_info" to="/camera/color/camera_info" />
            <remap from="image_rect" to="/camera/aligned_depth_to_color/image_raw" />
            <remap from="points" to="/camera/depth/points" />
        </node>

        <!-- 1.6 Load the robot URDF and start robot_state_publisher for TF static transforms -->
        <param name="robot_description" command="$(find xacro)/xacro '$(find nexus_4wd_mecanum_description)/urdf/nexus_4wd_mecanum.xacro'" />
        <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />

        <!-- 1.7 Start cmd_vel to chassis_control velocity bridge -->
        <node name="cmd_vel_to_chassis" pkg="hw4_exploration" type="cmd_vel_to_chassis.py" output="screen" />

        <!-- 2. Start AprilTag Localization (Real room tag list) -->
        <include file="$(find apriltag_localization)/launch/apriltag_localization.launch">
            <arg name="tag_file_name" value="2026/ee478_n1_room113" />
            <arg name="camera_name" value="/camera/color" />
            <arg name="image_topic" value="image_raw" />
            <arg name="world_frame_name" value="map" />
            <arg name="camera_frame_name" value="camera_link" />
            <arg name="image_frame_name" value="camera_color_optical_frame" />
            <arg name="with_visualization" value="false" />
            <arg name="with_realsense_tf" value="false" />
            <arg name="broadcast_world2cam_tf" value="false" />
        </include>

        <!-- 3. Start RTAB-Map SLAM (Configured for Visual Odometry) -->
        <include file="$(find rtabmap_launch)/launch/rtabmap.launch">
            <arg name="rtabmap_args" value="--delete_db_on_start --Vis/MaxFeatures 2000 --Kp/MaxFeatures 2000 --Rtabmap/LoopThr 0.1 --Rtabmap/DetectionRate 1.0 --Mem/ImagePreDecimation 4 --Grid/MaxObstacleHeight 0.15 --Grid/RayTracing true --RGBD/ProximityBySpace true --RGBD/OptimizeFromGraphEnd false --Vis/MinInliers 10"/>
            <arg name="rgb_topic" value="/camera/color/image_raw"/>
            <arg name="depth_topic" value="/camera/aligned_depth_to_color/image_raw"/>
            <arg name="camera_info_topic" value="/camera/color/camera_info"/>
            <arg name="depth_camera_info_topic" value="/camera/color/camera_info"/>
            <arg name="frame_id" value="base_footprint"/>
            <arg name="odom_topic" value="/odom"/>
            <arg name="visual_odometry" value="true"/>
            <arg name="icp_odometry" value="false"/>
            <arg name="publish_tf_odom" value="true"/>
            <arg name="vo_frame_id" value="odom"/>
            <arg name="subscribe_scan" value="false"/>
            <arg name="approx_sync" value="true"/>
            <arg name="rviz" value="false"/>
            <arg name="rtabmap_viz" value="false"/>
            <arg name="odom_args" value="--Odom/ResetCountdown 2 --Vis/MaxFeatures 600 --Vis/MinInliers 10 --OdomF2M/MaxSize 1000 --Odom/KeyFrameThr 0.6"/>
            <arg name="map_frame_id" value="rtabmap_map"/>
        </include>
    </group>

    <!-- ==================== COMMON SETUP ==================== -->

    <!-- 3.7 Start the Map Odom Publisher -->
    <node name="map_odom_publisher" pkg="hw4_exploration" type="map_odom_publisher.py" output="screen" />

    <!-- 4. Local costmap generator (obstacle topic 생산).
         heightmap_node          -> /points/velodyne_obstacles  (teb costmap이 먹는 소스)
         heightmap_to_costmap    -> /map/local_map/obstacle      (astar costmap이 먹는 소스)
         이게 빠져서 astar local_costmap 이 비어 있었음. teb 때는 이 launch 를 따로
         돌리고 있었던 것. astar 통합 launch 에도 반드시 포함해야 함. -->
    <include file="$(find local_costmap_generator)/launch/run.launch" />

    <!-- 5. Local planner = A* ONLY.
         run_astar_planner.launch 가 /local_planner_type=astar 를 set하고,
         A* 노드 + (inflation_layer 포함) local_costmap 을 띄운다. teb 미포함. -->
    <include file="$(find control_space_planner)/launch/run_astar_planner.launch" />

    <!-- 5.1 글로벌 /local_planner_type 을 astar 로 강제 고정.
         include(run_astar_planner.launch) 뒤에 두어, 그 안에서 ns/다른 값이
         들어오더라도 마지막에 글로벌 경로(/)를 astar 로 덮어쓴다.
         => 이전 teb 실행의 잔재값이 param 서버에 남아도 launch 시점에 astar 로 갱신됨. -->
    <param name="local_planner_type" type="str" value="astar" />

    <!-- run.launch 안에 함께 있던 나머지 planner 노드들 (param 게이트로 /cmd_vel 엔 조용) -->
    <node name="control_space_planner_node" pkg="control_space_planner" type="control_space_planner_node" output="screen"/>
    <node name="custom_vector_planner" pkg="control_space_planner" type="custom_vector_planner.py" output="screen"/>

    <!-- 6. Start LLM Client Node (Crash-free Startup) -->
    <node name="simple_llm_client" pkg="gpt_llm_client" type="simple_llm_client.py" output="screen" />

    <!-- 7. Start Vision Perception Services -->
    <node name="vision_perception_node" pkg="hw4_exploration" type="vision_perception_node.py" output="screen" />

    <!-- 8. Start Store Coordinator (Map Anchor Points) -->
    <node name="store_coordinator_node" pkg="hw4_exploration" type="store_coordinator_node.py" output="screen" />

    <!-- 9. Start AprilTag Visualizer -->
    <node name="tag_visualizer" pkg="hw4_exploration" type="tag_visualizer.py" output="screen" />

    <!-- 10. Start the Robot Web UI Server -->
    <node name="robot_web_ui_server" pkg="robot_web_ui" type="web_server_node_astar.py" output="screen" respawn="true">
        <param name="depth_topic" value="/camera/depth/image_raw" if="$(arg sim)" />
        <param name="depth_topic" value="/camera/aligned_depth_to_color/image_raw" unless="$(arg sim)" />
        <param name="enable_camera_viz" value="false" />
    </node>

    <!-- 11. Start Web Video Server and Throttles for much faster UI streaming -->
    <node name="web_video_server" pkg="web_video_server" type="web_video_server" output="screen">
        <param name="port" value="8080" />
    </node>
    <!-- Throttle the camera streams to 5 Hz to save bandwidth -->
    <node name="throttle_color" pkg="topic_tools" type="throttle" args="messages /camera/color/image_raw 10.0 /camera/color/image_raw_throttle" />
    <node name="throttle_depth" pkg="topic_tools" type="throttle" args="messages /camera/aligned_depth_to_color/image_raw 10.0 /camera/aligned_depth_to_color/image_raw_throttle" unless="$(arg sim)" />
    <node name="throttle_depth_sim" pkg="topic_tools" type="throttle" args="messages /camera/depth/image_raw 10.0 /camera/depth/image_raw_throttle" if="$(arg sim)" />

    <group if="$(arg use_rviz)">
        <node pkg="rviz" type="rviz" name="rviz_display" args="-d $(find hw4_exploration)/rviz/ee478_rtabmap.rviz" output="screen" />
    </group>
</launch>